{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "网址板",
  "version": "0.1.0",
  "identifier": "dev.url-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "网址板",
        "width": 520,
        "height": 720,
        "minHeight": 420,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
